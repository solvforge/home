# Copy to .env.local and fill in — required for the contact/quote forms to actually send email.
#
# Using Resend's SMTP relay (recommended, see README for setup steps):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587   (port 465 is blocked outbound in some sandboxed dev environments — 587 works everywhere)
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key, starts with re_>
#   CONTACT_FROM_EMAIL=<an address on a domain verified in Resend, e.g. forms@solvforge.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@solvforge.com

# Required for the Sveltia CMS admin panel (/admin) to log in — see docs/cms-setup.md.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to log into /admin. If unset, any
# GitHub account can reach the editor UI (though only repo collaborators can
# actually save/publish, since that goes through GitHub's own API).
GITHUB_OAUTH_ALLOWED_USERS=solvforge

# Optional — adds a reCAPTCHA v2 ("I'm not a robot") checkbox to the contact/quote
# forms. Both unset = no reCAPTCHA shown, forms work as before. Get keys at
# https://www.google.com/recaptcha/admin (register as v2 Checkbox, add this site's
# domain(s)). NEXT_PUBLIC_ is required so the site key reaches the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
