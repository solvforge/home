# Copy to .env.local and fill in — required for the contact/quote forms to actually send email.
#
# Using Resend's SMTP relay (recommended, see README for setup steps):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587   (port 465 is blocked outbound in some sandboxed dev environments — 587 works everywhere)
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key, starts with re_>
#   CONTACT_FROM_EMAIL=<an address on a domain verified in Resend, e.g. forms@solvforge.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@solvforge.com

# Required for the Sveltia CMS admin panel (/admin) to log in — see docs/cms-setup.md.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
